---
import Section from './Section.astro';
import ProjectCard from './ProjectCard.astro';
import type { Project } from '../types';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<Section
  id="projects"
  title="精选项目"
  subtitle="代表性项目，技术栈与链接一目了然。"
  muted
>
  {
    projects.length > 0 ? (
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    ) : (
      <div
        data-reveal
        class="mx-auto max-w-2xl rounded-card border border-border bg-card p-10 text-center"
      >
        <p class="text-2xl font-semibold text-accent">项目整理中</p>
        <p class="mt-3 leading-relaxed text-muted">
          首批 AI 编程项目正在准备中，完成后会在这里展示项目说明、技术栈与公开链接。
        </p>
        <a href="/#contact" class="btn btn-outline mt-6">
          先聊聊合作
        </a>
      </div>
    )
  }
</Section>
