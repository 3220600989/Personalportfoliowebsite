---
import { Image } from 'astro:assets';
import type { Profile } from '../types';

interface Props {
  profile: Profile;
}

const { profile } = Astro.props;
---

<section
  id="home"
  class="scroll-mt-20 overflow-hidden border-b border-border bg-gradient-to-b from-card to-bg"
>
  <div
    class="mx-auto grid max-w-5xl gap-12 px-4 py-20 sm:px-6 md:grid-cols-[1fr_auto] md:items-center md:py-28 lg:px-8"
  >
    <div data-reveal>
      {
        profile.status && (
          <p class="mb-6 inline-flex items-center gap-2 rounded-full border border-border bg-card px-3 py-1 text-xs text-accent">
            <span class="h-2 w-2 rounded-full bg-accent"></span>
            {profile.status}
          </p>
        )
      }
      <p class="mb-2 text-sm font-medium text-accent">你好，我是</p>
      <h1 class="text-[clamp(2.4rem,5vw,4rem)] font-bold leading-[1.15] tracking-tight">
        {profile.name}<span class="text-accent">.</span>
      </h1>
      <p class="mt-3 text-xl text-text/90 md:text-2xl">{profile.title}</p>
      <p class="mt-4 max-w-xl leading-relaxed text-muted">{profile.tagline}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/#projects" class="btn btn-primary">查看项目</a>
        <a href="/#contact" class="btn btn-outline">联系我</a>
      </div>
      {profile.location && <p class="mt-6 text-sm text-muted">{profile.location}</p>}
    </div>

    <div data-reveal>
      <Image
        src={profile.avatar}
        alt={`${profile.name}的头像`}
        widths={[240, 480]}
        sizes="240px"
        loading="eager"
        fetchpriority="high"
        class="h-48 w-48 rounded-card border border-border object-cover md:h-60 md:w-60"
      />
    </div>
  </div>
</section>
