---
interface Props {
  id: string;
  title: string;
  subtitle?: string;
  muted?: boolean;
}

const { id, title, subtitle, muted = false } = Astro.props;
---

<section
  id={id}
  class:list={[
    'scroll-mt-20 py-20 md:py-28',
    muted && 'border-y border-border bg-card/40',
  ]}
>
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <div data-reveal class="mb-10">
      <h2 class="text-3xl font-bold">{title}</h2>
      {subtitle && <p class="mt-2 text-muted">{subtitle}</p>}
    </div>
    <slot />
  </div>
</section>
