---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { profile } from '../data/profile';
---

<BaseLayout
  title="404 · 页面未找到"
  description="你访问的页面不存在或已被移动。"
  noindex
  analytics={site.analytics}
>
  <Header navItems={site.navItems} brand={profile.name} />
  <main
    id="main-content"
    class="mx-auto flex min-h-[70vh] max-w-5xl flex-col items-center justify-center px-4 text-center sm:px-6 lg:px-8"
  >
    <p class="text-6xl font-bold text-accent">404</p>
    <h1 class="mt-4 text-2xl font-semibold">页面走丢了</h1>
    <p class="mt-2 text-muted">你访问的页面不存在或已被移动。</p>
    <a href="/" class="btn btn-primary mt-8">返回首页</a>
  </main>
  <Footer brand={profile.name} />
</BaseLayout>
